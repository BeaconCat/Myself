  {
    "id": "m-principles",
    "type": "principles",
    "span": 3,
    "variant": "cols",
    "data": {
      "items": [
        {
          "title": "先写下来，再写好。",
          "text": "草稿比完美重要。记录本身，就是意义。"
        },
        {
          "title": "工具要像一扇门。",
          "text": "推开就能用；说明书是设计失败的补丁。"
        },
        {
          "title": "少，但不是空。",
          "text": "删掉噪音，留下一个主角，再把它做到极致。"
        },
        {
          "title": "公开地学习。",
          "text": "把半成品也放上来——路径比结果更值得分享。"
        }
      ]
    }
  },
