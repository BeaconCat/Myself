    "span": 3,
    "variant": "cols",
    "data": {
      "items": [
        {
          "title": "先写下来，再写好。",
          "text": "草稿比完美重要。记录本身，就是意义。"
        },
        {
          "title": "工具要像一扇门。",
          "text": "推开就能用，需要说明书的工具已经输了一半。"
        },
        {
          "title": "少，但不是空。",
          "text": "删掉能删的，留下的每一样都值得被看见。"
        },
        {
          "title": "保持好奇。",
          "text": "把每一次卡住，都当成一次顺路的学习。"
        }
      ]
    }
  },
